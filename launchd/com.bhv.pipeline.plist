<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
    <key>Label</key>             <string>com.bhv.pipeline</string>
    <key>ProgramArguments</key>
    <array>
        <string>__VENV_BIN__/python</string>
        <string>__PROJECT_DIR__/backend/pipeline.py</string>
    </array>
    <key>WorkingDirectory</key>  <string>__PROJECT_DIR__/backend</string>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>    <integer>6</integer>
        <key>Minute</key>  <integer>0</integer>
    </dict>
    <key>StandardOutPath</key>   <string>__LOG_DIR__/pipeline.log</string>
    <key>StandardErrorPath</key> <string>__LOG_DIR__/pipeline-error.log</string>
</dict></plist>
